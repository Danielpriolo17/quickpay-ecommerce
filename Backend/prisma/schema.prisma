generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DELIVERED
  CANCELLED
}

model Product {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(150)
  description  String        @db.Text
  priceInCents Int           @map("price_in_cents")
  stock        Int           @default(0)
  imageUrl     String        @map("image_url") @db.VarChar(500)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]

  @@map("products")
}

model Customer {
  id           String        @id @default(uuid())
  fullName     String        @map("full_name") @db.VarChar(150)
  email        String        @unique @db.VarChar(180)
  phone        String        @db.VarChar(30)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]
  deliveries   Delivery[]

  @@map("customers")
}

model Transaction {
  id                    String            @id @default(uuid())
  reference             String            @unique @db.VarChar(100)
  productId             String            @map("product_id")
  customerId            String            @map("customer_id")
  quantity              Int               @default(1)
  productAmountInCents  Int               @map("product_amount_in_cents")
  baseFeeInCents        Int               @map("base_fee_in_cents")
  deliveryFeeInCents    Int               @map("delivery_fee_in_cents")
  totalInCents          Int               @map("total_in_cents")
  status                TransactionStatus @default(PENDING)
  externalTransactionId String?           @map("external_transaction_id") @db.VarChar(120)
  paymentMethodType     String            @default("CARD") @map("payment_method_type") @db.VarChar(30)
  cardBrand             String?           @map("card_brand") @db.VarChar(20)
  cardLastFour          String?           @map("card_last_four") @db.VarChar(4)
  statusMessage         String?           @map("status_message") @db.VarChar(255)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  product  Product   @relation(fields: [productId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  delivery Delivery?

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@map("transactions")
}

model Delivery {
  id            String         @id @default(uuid())
  transactionId String         @unique @map("transaction_id")
  customerId    String         @map("customer_id")
  address       String         @db.VarChar(250)
  city          String         @db.VarChar(100)
  department    String         @db.VarChar(100)
  postalCode    String?        @map("postal_code") @db.VarChar(20)
  status        DeliveryStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("deliveries")
}